{
  "1":  {"class_type": "UNETLoader", "_meta": {"title": "Model (distilled int8)"},
         "inputs": {"unet_name": "ltx-2.5-22b-distilled-transformer-comfy-int8-convrot.safetensors", "weight_dtype": "default"}},
  "2":  {"class_type": "CLIPLoader", "_meta": {"title": "Text encoder (Gemma4-12B int8)"},
         "inputs": {"clip_name": "gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors", "type": "ltxv", "device": "default"}},
  "3":  {"class_type": "VAELoader", "_meta": {"title": "Video VAE"},
         "inputs": {"vae_name": "ltx-2.5-video-vae-bf16.safetensors"}},
  "4":  {"class_type": "VAELoader", "_meta": {"title": "Audio VAE"},
         "inputs": {"vae_name": "ltx-2.5-audio-vae-bf16.safetensors"}},

  "5":  {"class_type": "CLIPTextEncode", "_meta": {"title": "Positive prompt"},
         "inputs": {"clip": ["2", 0], "text": "Anime style, 2D cel-shaded animation. A girl with short silver hair and a red scarf stands on a rooftop at sunset, wind blowing her hair and scarf, city skyline glowing orange behind her. Slow push-in camera. She turns toward the camera and says softly, \"We made it.\" Ambient wind and distant city sounds."}},
  "6":  {"class_type": "CLIPTextEncode", "_meta": {"title": "Negative prompt"},
         "inputs": {"clip": ["2", 0], "text": "photorealistic, 3D render, live action, blurry, low quality, distorted face, extra limbs, watermark, text"}},
  "7":  {"class_type": "LTXVConditioning", "_meta": {"title": "Conditioning (fps)"},
         "inputs": {"positive": ["5", 0], "negative": ["6", 0], "frame_rate": 24.0}},

  "8":  {"class_type": "EmptyLTXVLatentVideo", "_meta": {"title": "Video latent (frames = 1 + 8k)"},
         "inputs": {"width": 960, "height": 544, "length": 121, "batch_size": 1}},
  "9":  {"class_type": "LTXVEmptyLatentAudio", "_meta": {"title": "Audio latent"},
         "inputs": {"audio_vae": ["4", 0], "frames_number": 121, "frame_rate": 24, "batch_size": 1}},
  "10": {"class_type": "LTXVConcatAVLatent", "_meta": {"title": "A/V latent"},
         "inputs": {"video_latent": ["8", 0], "audio_latent": ["9", 0]}},

  "11": {"class_type": "CFGGuider", "inputs": {"model": ["1", 0], "positive": ["7", 0], "negative": ["7", 1], "cfg": 1.0}},
  "12": {"class_type": "KSamplerSelect", "inputs": {"sampler_name": "euler_ancestral"}},
  "13": {"class_type": "RandomNoise", "_meta": {"title": "Seed"}, "inputs": {"noise_seed": 42}},
  "14": {"class_type": "ManualSigmas", "_meta": {"title": "Distilled 8-step sigmas"},
         "inputs": {"sigmas": "1.0, 0.99375, 0.9875, 0.98125, 0.975, 0.909375, 0.725, 0.421875, 0.0"}},
  "15": {"class_type": "SamplerCustomAdvanced",
         "inputs": {"noise": ["13", 0], "guider": ["11", 0], "sampler": ["12", 0], "sigmas": ["14", 0], "latent_image": ["10", 0]}},
  "16": {"class_type": "LTXVSeparateAVLatent", "inputs": {"av_latent": ["15", 0]}},

  "17": {"class_type": "VAEDecodeTiled", "_meta": {"title": "Decode video"},
         "inputs": {"samples": ["16", 0], "vae": ["3", 0], "tile_size": 512, "overlap": 64, "temporal_size": 128, "temporal_overlap": 32}},
  "18": {"class_type": "LTXVAudioVAEDecode", "_meta": {"title": "Decode audio"},
         "inputs": {"samples": ["16", 1], "audio_vae": ["4", 0]}},
  "19": {"class_type": "CreateVideo", "inputs": {"images": ["17", 0], "audio": ["18", 0], "fps": 24.0, "bit_depth": 8}},
  "20": {"class_type": "SaveVideo", "_meta": {"title": "Save"},
         "inputs": {"video": ["19", 0], "filename_prefix": "smoke/ltx25_t2v", "format": "auto", "codec": "auto"}}
}
